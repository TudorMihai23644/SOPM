// Schema bazei de date DeadlineHero, versiunea 1.
// Toate momentele de timp se stochează în UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskStatus {
  UPCOMING
  COMPLETED
  CANCELLED
  OVERDUE
}

enum LedgerKind {
  XP
  COINS
  HP
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  nickname        String   @unique
  timezone        String   @default("Europe/Bucharest")
  xpTotal         Int      @default(0) @map("xp_total")
  level           Int      @default(1)
  hp              Int      @default(100)
  coins           Int      @default(0)
  /// Zilele consecutive cu cel puțin o finalizare la timp (COMBO).
  streakDays      Int      @default(0) @map("streak_days")
  /// Ultima zi de joc (AAAA-LL-ZZ) numărată în serie.
  lastStreakDay   String?  @map("last_streak_day") @db.VarChar(10)
  /// Ultima zi de joc deschisă de job-ul daily-rollover (AAAA-LL-ZZ).
  lastRolloverDay String?  @map("last_rollover_day") @db.VarChar(10)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tasks         Task[]
  history       HistoryLog[]
  ledger        RewardLedger[]
  stamina       DailyStamina[]
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  membership    TeamMember?
  questsCreated Quest[]              @relation("QuestCreator")
  participation QuestParticipant[]   @relation("QuestParticipant")
  validations   QuestParticipant[]   @relation("QuestValidator")

  @@map("users")
}

model Task {
  id                String      @id @default(uuid()) @db.Uuid
  ownerId           String      @map("owner_id") @db.Uuid
  title             String      @db.VarChar(120)
  description       String?
  deadlineAt        DateTime    @map("deadline_at")
  difficulty        Difficulty
  status            TaskStatus  @default(UPCOMING)
  createdAt         DateTime    @default(now()) @map("created_at")
  completedAt       DateTime?   @map("completed_at")
  overdueAt         DateTime?   @map("overdue_at")
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at")
  postponeCount     Int         @default(0) @map("postpone_count")
  hpPenaltyApplied  Boolean     @default(false) @map("hp_penalty_applied")
  /// Starea dinaintea finalizării, la care revine Undo.
  completedFrom     TaskStatus? @map("completed_from")
  /// Undo se poate folosi o singură dată per activitate.
  undoUsed          Boolean     @default(false) @map("undo_used")
  /// Numărul finalizării; intră în cheia recompensei, ca o refinalizare după Undo să fie distinctă.
  completionAttempt Int         @default(0) @map("completion_attempt")

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  history HistoryLog[]

  @@index([ownerId, status, deadlineAt])
  @@index([status, deadlineAt])
  @@map("tasks")
}

model HistoryLog {
  id         String      @id @default(uuid()) @db.Uuid
  /// Ordinea scrierii, pentru evenimentele cu același moment.
  seq        BigInt      @default(autoincrement())
  userId     String      @map("user_id") @db.Uuid
  taskId     String?     @map("task_id") @db.Uuid
  taskTitle  String      @map("task_title") @db.VarChar(120)
  event      String
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus? @map("to_status")
  note       String?
  at         DateTime    @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, at, seq])
  @@index([userId, event, at])
  @@map("history_log")
}

/// Jurnal append-only al oricărei modificări de XP, monede sau HP.
model RewardLedger {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  kind      LedgerKind
  delta     Int
  reason    String
  refType   String     @map("ref_type")
  refId     String     @map("ref_id")
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // O recompensă de un anumit fel nu se acordă de două ori pentru același motiv și aceeași referință.
  @@unique([userId, kind, reason, refType, refId])
  @@map("reward_ledger")
}

model DailyStamina {
  userId    String   @map("user_id") @db.Uuid
  gameDay   DateTime @map("game_day") @db.Date
  xpAwarded Int      @default(0) @map("xp_awarded")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameDay])
  @@map("daily_stamina")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AppConfig {
  key   String @id
  value Json

  @@map("app_config")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum TeamRole {
  LEADER
  MEMBER
}

enum QuestStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  PENDING
  OVERDUE
  AWAITING_REVIEW
  VALIDATED
  EXCUSED
}

/// Echipa (Guild): 1–4 membri, cu seif comun și nivel propriu.
model Team {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(30)
  inviteCode String   @unique @map("invite_code") @db.VarChar(6)
  leaderId   String   @map("leader_id") @db.Uuid
  level      Int      @default(1)
  teamXp     Int      @default(0) @map("team_xp")
  vaultCoins Int      @default(0) @map("vault_coins")
  createdAt  DateTime @default(now()) @map("created_at")

  members TeamMember[]
  quests  Quest[]

  @@map("teams")
}

model TeamMember {
  teamId   String   @map("team_id") @db.Uuid
  /// Unic: un utilizator face parte dintr-o singură echipă.
  userId   String   @unique @map("user_id") @db.Uuid
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("team_members")
}

/// Shared Quest: sarcină de grup, vizibilă doar membrilor echipei.
model Quest {
  id             String      @id @default(uuid()) @db.Uuid
  teamId         String      @map("team_id") @db.Uuid
  creatorId      String?     @map("creator_id") @db.Uuid
  title          String      @db.VarChar(120)
  description    String?
  deadlineAt     DateTime    @map("deadline_at")
  difficulty     Difficulty
  status         QuestStatus @default(OPEN)
  createdAt      DateTime    @default(now()) @map("created_at")
  completedAt    DateTime?   @map("completed_at")
  bonusGrantedAt DateTime?   @map("bonus_granted_at")

  team         Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator      User?              @relation("QuestCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  participants QuestParticipant[]

  @@index([teamId, status, deadlineAt])
  @@index([status, deadlineAt])
  @@map("quests")
}

model QuestParticipant {
  questId          String            @map("quest_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  status           ParticipantStatus @default(PENDING)
  doneAt           DateTime?         @map("done_at")
  /// Completarea a venit după termen: 25% XP, fără bonus de grup.
  doneLate         Boolean           @default(false) @map("done_late")
  overdueAt        DateTime?         @map("overdue_at")
  hpPenaltyApplied Boolean           @default(false) @map("hp_penalty_applied")
  validatorId      String?           @map("validator_id") @db.Uuid
  validatedAt      DateTime?         @map("validated_at")
  rejectReason     String?           @map("reject_reason") @db.VarChar(200)
  autoValidated    Boolean           @default(false) @map("auto_validated")

  quest     Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user      User  @relation("QuestParticipant", fields: [userId], references: [id], onDelete: Cascade)
  validator User? @relation("QuestValidator", fields: [validatorId], references: [id], onDelete: SetNull)

  @@id([questId, userId])
  @@index([userId, status])
  @@index([status, doneAt])
  @@map("quest_participants")
}
