{
  "name": "deadlinehero",
  "private": true,
  "version": "0.1.0",
  "description": "DeadlineHero: sarcinile personale transformate într-un joc.",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @deadlinehero/shared && npm run build -w @deadlinehero/api && npm run build -w @deadlinehero/web",
    "dev:api": "npm run build -w @deadlinehero/shared && npm run dev -w @deadlinehero/api",
    "dev:web": "npm run dev -w @deadlinehero/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run prisma:migrate -w @deadlinehero/api",
    "db:seed": "npm run prisma:seed -w @deadlinehero/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
